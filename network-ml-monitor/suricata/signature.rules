# Simple HTTP detection rule
alert http any any -> any 80 (msg:"HTTP Traffic Detected"; sid:1; rev:1;)

# Potential SQL injection attempt
alert http any any -> any any (msg:"SQL Injection Detected"; 
  content:"union"; nocase; http_uri; 
  content:"select"; nocase; http_uri; 
  sid:2; rev:1;)

# High volume traffic (potential DoS)
alert ip any any -> any any (msg:"High Traffic Volume"; 
  threshold:type threshold, track by_src, count 100, seconds 10; 
  sid:3; rev:1;)